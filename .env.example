# ═══════════════════════════════════════════════════════════════
# Archivo de ejemplo de variables de entorno.
# Copiar como .env y llenar con valores reales:
#   cp .env.example .env
# ═══════════════════════════════════════════════════════════════

# ── PostgreSQL ──
POSTGRES_USER=freelancer_admin
POSTGRES_PASSWORD=CAMBIAR_POR_PASSWORD_SEGURO
POSTGRES_DB=freelancer_db

# ── Connection Strings (una base compartida, schemas por servicio) ──
USUARIOS_DB_CONNECTION=Host=postgres;Port=5432;Database=freelancer_db;Username=freelancer_admin;Password=CAMBIAR_POR_PASSWORD_SEGURO
ADMIN_DB_CONNECTION=Host=postgres;Port=5432;Database=freelancer_db;Username=freelancer_admin;Password=CAMBIAR_POR_PASSWORD_SEGURO
CHAT_DB_CONNECTION=Host=postgres;Port=5432;Database=freelancer_db;Username=freelancer_admin;Password=CAMBIAR_POR_PASSWORD_SEGURO
MARKETPLACE_DB_CONNECTION=Host=postgres;Port=5432;Database=freelancer_db;Username=freelancer_admin;Password=CAMBIAR_POR_PASSWORD_SEGURO
RESENAS_DB_CONNECTION=Host=postgres;Port=5432;Database=freelancer_db;Username=freelancer_admin;Password=CAMBIAR_POR_PASSWORD_SEGURO

# ── JWT (compartido entre microservicios) ──
JWT_KEY=tu-clave-secreta-super-segura-de-al-menos-32-caracteres-aqui
JWT_ISSUER=CodeBridge
JWT_AUDIENCE=CodeBridgeUsuarios
JWT_EXPIRA_MINUTOS=60

# ── Correo para recuperación de contraseña (Usuarios API) ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=CAMBIAR_POR_USUARIO_SMTP
SMTP_PASSWORD=CAMBIAR_POR_PASSWORD_SMTP
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_FROM_NAME=TalentBridge
PASSWORD_RESET_URL=http://localhost:8100/auth/restablecer-password
PASSWORD_RESET_EXPIRY_MINUTES=30

# ── Cloudflare Tunnel ──
CLOUDFLARE_TUNNEL_TOKEN=tu-token-del-tunnel-aqui
