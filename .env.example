# ═══════════════════════════════════════════════════════════════
# Archivo de ejemplo de variables de entorno.
# Copiar como .env y llenar con valores reales:
#   cp .env.example .env
# ═══════════════════════════════════════════════════════════════

# ── PostgreSQL ──
POSTGRES_USER=freelancer_admin
POSTGRES_PASSWORD=CAMBIAR_POR_PASSWORD_SEGURO
POSTGRES_DB=freelancer_db

# ── Connection Strings (cada microservicio a su BD) ──
USUARIOS_DB_CONNECTION=Host=postgres;Port=5432;Database=freelancer_usuarios;Username=freelancer_admin;Password=CAMBIAR_POR_PASSWORD_SEGURO
ADMIN_DB_CONNECTION=Host=postgres;Port=5432;Database=freelancer_admin;Username=freelancer_admin;Password=CAMBIAR_POR_PASSWORD_SEGURO
CHAT_DB_CONNECTION=Host=postgres;Port=5432;Database=freelancer_chat;Username=freelancer_admin;Password=CAMBIAR_POR_PASSWORD_SEGURO
MARKETPLACE_DB_CONNECTION=Host=postgres;Port=5432;Database=freelancer_marketplace;Username=freelancer_admin;Password=CAMBIAR_POR_PASSWORD_SEGURO
RESENAS_DB_CONNECTION=Host=postgres;Port=5432;Database=freelancer_resenas;Username=freelancer_admin;Password=CAMBIAR_POR_PASSWORD_SEGURO

# ── JWT (compartido entre microservicios) ──
JWT_KEY=tu-clave-secreta-super-segura-de-al-menos-32-caracteres-aqui
JWT_ISSUER=CodeBridge
JWT_AUDIENCE=CodeBridgeUsuarios
JWT_EXPIRA_MINUTOS=60

# ── Cloudflare Tunnel ──
CLOUDFLARE_TUNNEL_TOKEN=tu-token-del-tunnel-aqui
